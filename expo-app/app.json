{
  "expo": {
    "name": "ethos",
    "slug": "ethos",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ethos",
    "icon": "./app-icons/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "bundleIdentifier": "com.s9swata.ethos"
    },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#000000"
    },
    "permissions": [
      "android.permission.RECORD_AUDIO",
      "android.permission.MODIFY_AUDIO_SETTINGS",
      "android.permission.FOREGROUND_SERVICE",
      "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
    ],
    "package": "com.s9swata.ethos",
    "versionCode": 9,
    "usesCleartextTraffic": true
  },
    "web": {
      "favicon": "./app-icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "abiFilters": [
              "arm64-v8a"
            ],
            "enableProguardInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./app-icons/icon.png",
          "imageWidth": 200,
          "dark": {
            "image": "./app-icons/icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-image",
      "expo-font",
      "./plugins/withCleartextDebug"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc69982d-e03d-4853-8fa4-0a5878555463"
      }
    },
    "owner": "saswat4s-organization"
  }
}
