{
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "shell:default",
    "shell:allow-spawn",
    "shell:allow-execute",
    { "identifier": "shell:allow-open", "allow": [{ "url": "http://*" }, { "url": "https://*" }] }
  ]
}
