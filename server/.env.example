PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# yt-dlp binary path (default: yt-dlp)
YT_DLP_PATH=yt-dlp

# yt-dlp concurrency and timeouts
YT_DLP_MAX_CONCURRENT=3
YT_DLP_TIMEOUT_MS=30000
QUEUE_TIMEOUT_MS=15000

# YouTube client rotation order (comma-separated, tried in sequence on 429)
YT_DLP_CLIENTS=android,ios,tv,web

# Proxy settings — one of:
#   YT_DLP_PROXY_LIST: comma-separated list in ip:port:user:pass format (rotated randomly per request)
#   YT_DLP_PROXY: single proxy URL fallback (e.g. http://user:pass@host:port)
YT_DLP_PROXY_LIST=
YT_DLP_PROXY=

# Path to Netscape cookies.txt file (use a Render Secret File for production)
YT_DLP_COOKIES_PATH=

# Cache settings
CACHE_DIR=./cache
CACHE_TTL_SEARCH=300
CACHE_TTL_METADATA=3600
CACHE_TTL_STREAM=600

# Rate limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Input validation
MAX_QUERY_LENGTH=200
